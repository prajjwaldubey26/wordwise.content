# Copy this file to .env and fill in real values.
# Spring Boot reads these as OS/process environment variables
# (set them in your shell, IDE run config, or deployment platform).
# Do not commit a real .env file.

# --- Server ---
SERVER_PORT=8080

# --- MySQL ---
DB_URL=jdbc:mysql://localhost:3306/ai_content_detector?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=Prajjwal@12

# --- Auth (JWT) ---
# Use a long random string (at least 32 characters) in production.
JWT_SECRET=local-development-secret-change-before-deployment-please-2026
JWT_EXPIRATION_MS=86400000

# --- CORS / frontend ---
# Comma-separated list of allowed browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://wordwise-content.vercel.app
FRONTEND_URL=http://localhost:3000

# --- AI provider for content generation, summaries, and quizzes ---
# Options: mock | openai | anthropic
# mock = offline demo (no key required). Cloud providers fall back to mock if the key is missing or the call fails.
AI_PROVIDER=mock

# Required when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Stripe (payments / PRO upgrade) ---
# Leave blank to disable checkout. Use a test key from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
