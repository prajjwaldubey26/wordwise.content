# Copy this file to .env and fill in real values.
# Spring Boot reads these as OS/process environment variables
# (set them in your shell, IDE run config, or deployment platform).
# Do not commit a real .env file.

# --- Server ---
SERVER_PORT=8080

# --- MySQL ---
# Local example:
# DB_URL=jdbc:mysql://localhost:3306/ai_content_detector?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=

# Aiven example:
DB_URL=jdbc:mysql://YOUR_AIVEN_HOST:YOUR_PORT/defaultdb?sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=avnadmin
DB_PASSWORD=

# --- Auth (JWT) ---
JWT_SECRET=local-development-secret-change-before-deployment-please-2026
JWT_EXPIRATION_MS=86400000

# --- CORS / frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://wordwise-content.vercel.app
FRONTEND_URL=http://localhost:3000

# --- AI provider for content generation, summaries, and quizzes ---
# Options: mock | openai | nvidia | anthropic
AI_PROVIDER=mock

# Required when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required when AI_PROVIDER=nvidia (key from https://build.nvidia.com/)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Required when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Stripe (payments / PRO upgrade) ---
STRIPE_SECRET_KEY=
